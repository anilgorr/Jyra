{
  "name": "@workspace/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate --config ./drizzle.config.ts",
    "migrate": "node --env-file-if-exists=../../.env ./scripts/migrate.mjs",
    "push": "node --env-file-if-exists=../../.env ./node_modules/.bin/drizzle-kit push --config ./drizzle.config.ts && node --env-file-if-exists=../../.env ./scripts/apply-invariants.mjs",
    "push-force": "node ./scripts/confirm-push-force.mjs && drizzle-kit push --force --config ./drizzle.config.ts && node ./scripts/apply-invariants.mjs",
    "test:invariants": "node ./scripts/test-invariants.mjs",
    "test:migrations": "node ./scripts/test-migrations.mjs",
    "approve-dev-db": "node --env-file-if-exists=../../.env ./scripts/approve-development-db.mjs"
  },
  "dependencies": {
    "drizzle-orm": "catalog:",
    "drizzle-zod": "^0.8.3",
    "pg": "^8.22.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10"
  }
}
