# JYRA local development — copy to .env at the repo root and fill in.
# .env is git-ignored. Every process (API, Vite, DB scripts) reads this file.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---- Database (docker compose up -d starts this) ---------------------------
DATABASE_URL=postgresql://jyra:jyra@localhost:5432/jyra

# ---- Auth: Clerk -----------------------------------------------------------
# On Replit, auth was Replit's managed Clerk instance. Outside Replit you need
# your own: https://dashboard.clerk.com -> create application -> API Keys.
# Development keys (pk_test_/sk_test_) are correct for local dev.
# The server REFUSES to start with a pk_test_ key when NODE_ENV=production.
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Same value as CLERK_PUBLISHABLE_KEY (Node's --env-file does not expand variables)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: comma-separated Clerk user ids allowed to hit /api/admin/*
JYRA_INTERNAL_ADMIN_USER_IDS=

# ---- LLM: OpenAI -----------------------------------------------------------
# On Replit these pointed at Replit's AI proxy. Outside, use OpenAI directly.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Research providers (each optional; the router skips unconfigured ones) --
TAVILY_API_KEY=
EXA_API_KEY=
BRIGHTDATA_API_KEY=
# Apify is reached through the Replit connectors SDK on Replit. Outside Replit
# the Apify provider is unavailable until it is re-pointed at the Apify API.

# ---- Intelligence engine ----------------------------------------------------
JYRA_INTELLIGENCE_VERSION=JYRA_INTELLIGENCE_V2
MARKET_READINESS_PROCESSING_ENABLED=true
MARKET_READINESS_V2_SEMANTIC_MAX_CENTS=5

# ---- Security (all optional; sane defaults) --------------------------------
# JYRA_ALLOWED_HOSTS=localhost:8080,localhost:5173
# JYRA_TRUST_PROXY_HOPS=1
# JYRA_RATE_LIMIT_WINDOW_MS=900000
# JYRA_RATE_LIMIT_GLOBAL_MAX=1000
# JYRA_RATE_LIMIT_PAID_MAX=30

# ---- Research budget defaults, in cents (fail-closed when unset per project) --
# JYRA_DEFAULT_DAILY_RESEARCH_BUDGET_CENTS=2500
# JYRA_DEFAULT_MONTHLY_RESEARCH_BUDGET_CENTS=25000
# JYRA_MAX_DAILY_RESEARCH_BUDGET_CENTS=100000
# JYRA_MAX_MONTHLY_RESEARCH_BUDGET_CENTS=1000000

# ---- Frontend --------------------------------------------------------------
# VITE_JYRA_V2_PANEL=true
