modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.development]
BRIGHTDATA_TEST_COMPANY_NAME = "Emergys"
BRIGHTDATA_TEST_LINKEDIN_URL = "https://www.linkedin.com/company/emergys-llc/"
JYRA_INTELLIGENCE_VERSION = "JYRA_INTELLIGENCE_V2"

[userenv.shared]
MARKET_READINESS_PROCESSING_ENABLED = "true"
MARKET_READINESS_V2_SEMANTIC_MAX_CENTS = "5"
