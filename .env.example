# JYRA local development — copy to .env at the repo root and fill in.
# .env is git-ignored. Every process (API, Vite, DB scripts) reads this file.

# ---- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---- Database (docker compose up -d starts this) ---------------------------
DATABASE_URL=postgresql://jyra:jyra@localhost:5432/jyra

# ---- Auth mode -------------------------------------------------------------
# `local` (the local-development default below): no sign-in, no Clerk keys.
#   Every request runs as one fixed developer identity; the sidebar shows a
#   "Local auth mode" pill. The API refuses to boot in this mode when
#   NODE_ENV=production or REPLIT_DEPLOYMENT=1, and `vite build` refuses a
#   production bundle with it. There is no override.
# `clerk` (the production mode, and the default when the variable is unset):
#   real accounts through Clerk; the Clerk block below then becomes REQUIRED.
# Set both — the API reads JYRA_AUTH_MODE, the web app reads VITE_JYRA_AUTH_MODE
# (Node's --env-file does not expand variables).
JYRA_AUTH_MODE=local
VITE_JYRA_AUTH_MODE=local
# Optional: the fixed identity used in local mode (default local-dev-user)
# JYRA_LOCAL_USER_ID=local-dev-user

# ---- Auth: Clerk (required only when JYRA_AUTH_MODE=clerk) -----------------
# On Replit, auth was Replit's managed Clerk instance. Outside Replit you need
# your own: https://dashboard.clerk.com -> create application -> API Keys.
# Development keys (pk_test_/sk_test_) are correct for local dev.
# The server REFUSES to start with a pk_test_ key when NODE_ENV=production.
# CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Same value as CLERK_PUBLISHABLE_KEY (Node's --env-file does not expand variables)
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Who may open the admin panel (/admin/access, /admin/quality). Either or both:
#   ADMIN_EMAILS                 comma-separated emails, matched against the
#                                verified PRIMARY email on the Clerk account
#   JYRA_INTERNAL_ADMIN_USER_IDS comma-separated Clerk user ids
# In local auth mode the local developer is always an internal admin.
ADMIN_EMAILS=
JYRA_INTERNAL_ADMIN_USER_IDS=

# ---- LLM: OpenAI -----------------------------------------------------------
# On Replit these pointed at Replit's AI proxy. Outside, use OpenAI directly.
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_INTEGRATIONS_OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# ---- Research providers (each optional; the router skips unconfigured ones) --
TAVILY_API_KEY=
EXA_API_KEY=
BRIGHTDATA_API_KEY=
# Apify is reached through the Replit connectors SDK on Replit. Outside Replit
# the Apify provider is unavailable until it is re-pointed at the Apify API.

# ---- Intelligence engine ----------------------------------------------------
JYRA_INTELLIGENCE_VERSION=JYRA_INTELLIGENCE_V2
MARKET_READINESS_PROCESSING_ENABLED=true
MARKET_READINESS_V2_SEMANTIC_MAX_CENTS=5

# ---- Security (all optional; sane defaults) --------------------------------
# JYRA_ALLOWED_HOSTS=localhost:8080,localhost:5173
# JYRA_TRUST_PROXY_HOPS=1
# JYRA_RATE_LIMIT_WINDOW_MS=900000
# JYRA_RATE_LIMIT_GLOBAL_MAX=1000
# JYRA_RATE_LIMIT_PAID_MAX=30

# ---- Research budget defaults, in cents (fail-closed when unset per project) --
# JYRA_DEFAULT_DAILY_RESEARCH_BUDGET_CENTS=2500
# JYRA_DEFAULT_MONTHLY_RESEARCH_BUDGET_CENTS=25000
# JYRA_MAX_DAILY_RESEARCH_BUDGET_CENTS=100000
# JYRA_MAX_MONTHLY_RESEARCH_BUDGET_CENTS=1000000

# ---- Watch loop ------------------------------------------------------------
# Off unless explicitly "true". The cadence is per tier: HOT (a live signal or
# an open opportunity) and DAILY (changed within a month, or added within a
# week) are looked at every JYRA_WATCH_HOT_DAYS; everything else every
# JYRA_WATCH_COLD_DAYS. A look is a change-gate check — page hashes and the
# ATS job count — and costs a fraction of a cycle, so far more of them fit in
# a tick than cycles do.
# JYRA_WATCH_LOOP_ENABLED=true
# JYRA_WATCH_LOOP_TOKEN=                     # 32+ chars; the scheduler's bearer token
# JYRA_WATCH_HOT_DAYS=1
# JYRA_WATCH_COLD_DAYS=7
# JYRA_WATCH_MAX_PER_TICK=10                 # full cycles per tick (cap 50)
# JYRA_WATCH_MAX_GATES_PER_TICK=60           # cheap looks per tick (cap 500)
# JYRA_WATCH_CADENCE_DAYS=7                  # pre-tier setting; still sets the cold cadence

# ---- Plans -----------------------------------------------------------------
# The plan an organisation falls back to when nobody has assigned one. Starter
# by default so a new organisation meets a limit early and cheaply rather than
# running up a bill nobody agreed to.
# JYRA_DEFAULT_PLAN=starter

# ---- Frontend --------------------------------------------------------------
# VITE_JYRA_V2_PANEL=true
